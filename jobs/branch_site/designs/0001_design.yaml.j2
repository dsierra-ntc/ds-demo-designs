---
{% set office_name = office.name %}
{% set office_prefix_cidr = office_prefix.prefix | string %}
{% set vlans = vlan_sets[office_type] %}

prefixes:
  - "!get:id": "{{ office_prefix.id }}"
    "!ref": "parent_prefix"

locations:
  - "!create_or_update:id": "{{ office.id }}"
    "!ref": "office"
    vlans:
    {% for v in vlans %}
      - "!create_or_update:vid": {{ v.vid }}
        "!create_or_update:name": "{{ office_name }}-{{ v.name }}"
        description: "{{ v.description }}"
        status__name: "Active"
        "!ref": "vlan_{{ v.vid }}"
    {% endfor %}

racks:
  - "!create_or_update:name": "{{ office_name }}-101"
    "!ref": "rack1"
    location: "!ref:office"
    status__name: "Planned"

{% macro device_name(role, index, office) %}{{ device_detail[role].name_prefix }}-{{ '%02d' | format(index) }}.{{ office | lower }}{% endmacro %}
{% set device_counts = get_device_counts() %}

devices:
{% for device, count in device_counts.items() %}
    {% for i in range(0, count) %}
  - "!create_or_update:name": "{{ device_name(device, loop.index, office_name) }}"
    location: "!ref:office"
    device_type__model: "{{ device_detail[device].model }}"
    role__name: "{{ device_detail[device].role }}"
    platform__name: "{{ device_detail[device].platform }}"
    status__name: "Planned"
    {% if device_detail[device].rack is defined %}
    rack: "!ref:{{ device_detail[device].rack }}"
    {% endif %}
    {% if device_detail[device].position is defined %}
    position: "{{ device_detail[device].position[i] }}" 
    face: front
    {% endif %}
    {% endfor %}
{% endfor %}