---
{% set office_name = office.name %}
{% set office_prefix_cidr = office_prefix.prefix | string %}
{% set vlans = vlan_sets[office_type] %}

prefixes:
  - "!get:id": "{{ office_prefix.id }}"
    "!ref": "parent_prefix"

locations:
  - "!create_or_update:id": "{{ office.id }}"
    "!ref": "office"
    vlans:
    {% for v in vlans %}
      - "!create_or_update:vid": {{ v.vid }}
        "!create_or_update:name": "{{ office_name }}-{{ v.name }}"
        description: "{{ v.description }}"
        status__name: "Active"
        "!ref": "vlan_{{ v.vid }}"
    {% endfor %}
    prefixes:
    {% for v in vlans %}
      - "!create_or_update:prefix": "{{ get_child_prefix_cidr(office_prefix_cidr, v.offset) }}"
        status__name: "Active"
        locations: ["!ref:office"]
        vlan: "!ref:vlan_{{ v.vid }}"
        "!ref": "vlan_prefix_{{ v.vid }}"
    {% endfor %}

racks:
  - "!create_or_update:name": "{{ office_name }}-101"
    "!ref": "rack1"
    location: "!ref:office"
    status__name: "Planned"

{% set mgmt_vlan = vlans | selectattr('name', 'eq', management.vlan) | first %}
{% set mgmt_base = mgmt_vlan.offset.split('/')[0].rsplit('.', 1)[0] %}
{% set mgmt_mask = mgmt_vlan.offset.split('/')[1] %}
{% macro mgmt_ip(host) %}{{ office_prefix_cidr | network_offset(mgmt_base ~ '.' ~ host ~ '/' ~ mgmt_mask) }}{% endmacro %}
{% macro dev_name(base) %}{{ base }}.{{ office_name | lower }}{% endmacro %}

devices:
# Static devices
{% for d in static_devices %}
  - "!create_or_update:name": "{{ dev_name(d.name) }}"
    location: "!ref:office"
    device_type__model: "{{ d.model }}"
    role__name: "{{ d.role }}"
    platform__name: "{{ d.platform }}"
    status__name: "Planned"
    {% if d.rack is defined %}
    rack: "!ref:{{ d.rack }}"
    position: {{ d.position }}
    face: front
    {% endif %}
    "!ref": "{{ d.name }}"
    interfaces:
      - "!create_or_update:name": "{{ d.mgmt_interface }}"
        ip_address_assignments:
          - ip_address:
              "!create_or_update:address": "{{ mgmt_ip(d.host) }}"
              status__name: "Active"
    primary_ip4: { "!get:address": "{{ mgmt_ip(d.host) }}", deferred: true }
{% endfor %}

# Dynamic switch stack
{% for i in range(switch_stack_size) %}
  - "!create_or_update:name": "{{ dev_name('switch' ~ (i + 1)) }}"
    location: "!ref:office"
    device_type__model: "{{ switch.model }}"
    role__name: "{{ switch.role }}"
    platform__name: "{{ switch.platform }}"
    status__name: "Planned"
    rack: "!ref:{{ switch.rack }}"
    position: {{ switch.positions[i] }}
    face: front
    "!ref": "switch{{ i + 1 }}"
    {% if i == 0 %}
    virtual_chassis:
      "!create_or_update:name": "{{ office_name | lower }}-{{ switch.vc_name }}"
      domain: "{{ office_name | upper }} VC"
      master: "!ref:switch{{ i + 1 }}"
      deferred: true
    {% else %}
    virtual_chassis:
      "!get:name": "{{ office_name | lower }}-{{ switch.vc_name }}"
    {% endif %}
    vc_position: {{ i + 1 }}
    vc_priority: {{ switch.vc_priorities[i] }}
    interfaces:
      - "!create_or_update:name": "{{ switch.mgmt_interface }}"
        ip_address_assignments:
          - ip_address:
              "!create_or_update:address": "{{ mgmt_ip(switch.hosts[i]) }}"
              status__name: "Active"
    primary_ip4: { "!get:address": "{{ mgmt_ip(switch.hosts[i]) }}", deferred: true }
{% endfor %}

# Dynamic PDUs
{% for i in range(pdu_count) %}
  - "!create_or_update:name": "{{ dev_name('pdu' ~ (i + 1)) }}"
    location: "!ref:office"
    device_type__model: "{{ pdu.model }}"
    role__name: "{{ pdu.role }}"
    platform__name: "{{ pdu.platform }}"
    status__name: "Planned"
    rack: "!ref:{{ pdu.rack }}"
    position: {{ pdu.positions[i] }}
    face: front
    "!ref": "pdu{{ i + 1 }}"
    interfaces:
      - "!create_or_update:name": "{{ pdu.mgmt_interface }}"
        ip_address_assignments:
          - ip_address:
              "!create_or_update:address": "{{ mgmt_ip(pdu.hosts[i]) }}"
              status__name: "Active"
    primary_ip4: { "!get:address": "{{ mgmt_ip(pdu.hosts[i]) }}", deferred: true }
{% endfor %}

# Access points
{% for i in range(ap_count) %}
  - "!create_or_update:name": "{{ dev_name('ap' ~ i) }}"
    location: "!ref:office"
    device_type__model: "{{ access_point.model }}"
    role__name: "{{ access_point.role }}"
    status__name: "Planned"
    interfaces:
      - "!create_or_update:name": "{{ access_point.mgmt_interface }}"
        ip_address_assignments:
          - ip_address:
              "!create_or_update:address": "{{ mgmt_ip(access_point.first_host + i) }}"
              status__name: "Active"
    primary_ip4: { "!get:address": "{{ mgmt_ip(access_point.first_host + i) }}", deferred: true }
{% endfor %}

cables:
# Static device cables
  - "!lookup:termination_a":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('firewall01') }}"
      name: "ethernet1/1"
    "!lookup:termination_b":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('switch01') }}"
      name: "Eth1/1"
    status__name: "Planned"
  - "!lookup:termination_a":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('opengear01') }}"
      name: "sw0p0"
    "!lookup:termination_b":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('switch01') }}"
      name: "Eth1/2"
    status__name: "Planned"
  - "!lookup:termination_a":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('firewall02') }}"
      name: "ethernet1/1"
    "!lookup:termination_b":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('switch02') }}"
      name: "Eth1/1"
    status__name: "Planned"

# PDU to switch cables
{% for i in range(pdu_count) %}
  - "!lookup:termination_a":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('pdu' ~ (i + 1)) }}"
      name: "{{ pdu.mgmt_interface }}"
    "!lookup:termination_b":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('switch01') }}"
      name: "Eth1/{{ 3 + i }}"
    status__name: "Planned"
{% endfor %}

# Access point cables
{% for i in range(ap_count) %}
  - "!lookup:termination_a":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('ap' ~ i) }}"
      name: "{{ access_point.mgmt_interface }}"
    "!lookup:termination_b":
      content-type: "dcim.interface"
      device__name: "{{ dev_name(access_point.switch) }}"
      name: "Eth1/{{ access_point.first_port + i }}"
    status__name: "Planned"
{% endfor %}
