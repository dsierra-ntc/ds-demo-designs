---
{% set office_name = office.name %}
{% set office_prefix_cidr = office_prefix.prefix | string %}
{% set vlans = vlan_sets[office_type] %}
{% set mgmt_vlan = vlans | selectattr('name', 'eq', management.vlan) | first %}

prefixes:
  - "!get:id": "{{ office_prefix.id }}"
    "!ref": "parent_prefix"
{% for v in vlans %}
  - "!next_prefix":
      prefix: ["{{ office_prefix_cidr }}"]
      length: {{ v.prefixlen }}
    status__name: "Active"
    "!ref": "vlan_prefix_{{ v.vid }}"
{% endfor %}

ip_addresses:
{% for d in static_devices | selectattr('role', 'eq', 'Firewall') | list %}
  - "!next_ip":
      prefix: "!ref:vlan_prefix_{{ mgmt_vlan.vid }}"
    "!ref": "ip_firewall_{{ loop.index0 }}"
    status__name: "Active"
{% endfor %}
{% for d in static_devices | selectattr('role', 'eq', 'Console Server') | list %}
  - "!next_ip":
      prefix: "!ref:vlan_prefix_{{ mgmt_vlan.vid }}"
    "!ref": "ip_console_{{ loop.index0 }}"
    status__name: "Active"
{% endfor %}
{% for i in range(switch_stack_size) %}
  - "!next_ip":
      prefix: "!ref:vlan_prefix_{{ mgmt_vlan.vid }}"
    "!ref": "ip_switch_{{ i }}"
    status__name: "Active"
{% endfor %}
{% for i in range(pdu_count) %}
  - "!next_ip":
      prefix: "!ref:vlan_prefix_{{ mgmt_vlan.vid }}"
    "!ref": "ip_pdu_{{ i }}"
    status__name: "Active"
{% endfor %}
{% for i in range(ap_count) %}
  - "!next_ip":
      prefix: "!ref:vlan_prefix_{{ mgmt_vlan.vid }}"
    "!ref": "ip_ap_{{ i }}"
    status__name: "Active"
{% endfor %}

locations:
  - "!create_or_update:id": "{{ office.id }}"
    "!ref": "office"
    vlans:
    {% for v in vlans %}
      - "!create_or_update:vid": {{ v.vid }}
        "!create_or_update:name": "{{ office_name }}-{{ v.name }}"
        description: "{{ v.description }}"
        status__name: "Active"
        "!ref": "vlan_{{ v.vid }}"
        prefix: "!ref:vlan_prefix_{{ v.vid }}"
    {% endfor %}

racks:
  - "!create_or_update:name": "{{ office_name }}-101"
    "!ref": "rack1"
    location: "!ref:office"
    status__name: "Planned"

{% macro dev_name(base) %}{{ base }}.{{ office_name | lower }}{% endmacro %}

devices:
# Static devices - firewalls
{% for d in static_devices | selectattr('role', 'eq', 'Firewall') | list %}
  - "!create_or_update:name": "{{ dev_name(d.name) }}"
    location: "!ref:office"
    device_type__model: "{{ d.model }}"
    role__name: "{{ d.role }}"
    platform__name: "{{ d.platform }}"
    status__name: "Planned"
    {% if d.rack is defined %}
    rack: "!ref:{{ d.rack }}"
    position: {{ get_device_position("firewall", loop.index0) }}
    face: front
    {% endif %}
    "!ref": "{{ d.name }}"
    interfaces:
      - "!create_or_update:name": "{{ d.mgmt_interface }}"
        ip_address_assignments:
          - ip_address: "!ref:ip_firewall_{{ loop.index0 }}"
    primary_ip4: { "!get:address": "!ref:ip_firewall_{{ loop.index0 }}", deferred: true }
{% endfor %}

# Static devices - console servers
{% for d in static_devices | selectattr('role', 'eq', 'Console Server') | list %}
  - "!create_or_update:name": "{{ dev_name(d.name) }}"
    location: "!ref:office"
    device_type__model: "{{ d.model }}"
    role__name: "{{ d.role }}"
    platform__name: "{{ d.platform }}"
    status__name: "Planned"
    {% if d.rack is defined %}
    rack: "!ref:{{ d.rack }}"
    position: {{ get_device_position("console", loop.index0) }}
    face: front
    {% endif %}
    "!ref": "{{ d.name }}"
    interfaces:
      - "!create_or_update:name": "{{ d.mgmt_interface }}"
        ip_address_assignments:
          - ip_address: "!ref:ip_console_{{ loop.index0 }}"
    primary_ip4: { "!get:address": "!ref:ip_console_{{ loop.index0 }}", deferred: true }
{% endfor %}

# Dynamic switch stack
{% for i in range(switch_stack_size) %}
  - "!create_or_update:name": "{{ dev_name('switch' ~ (i + 1)) }}"
    location: "!ref:office"
    device_type__model: "{{ switch.model }}"
    role__name: "{{ switch.role }}"
    platform__name: "{{ switch.platform }}"
    status__name: "Planned"
    rack: "!ref:{{ switch.rack }}"
    position: {{ get_device_position("switch", i) }}
    face: front
    "!ref": "switch{{ i + 1 }}"
    {% if i == 0 %}
    virtual_chassis:
      "!create_or_update:name": "{{ office_name | lower }}-{{ switch.vc_name }}"
      domain: "{{ office_name | upper }} VC"
      master: "!ref:switch{{ i + 1 }}"
      deferred: true
    {% else %}
    virtual_chassis:
      "!get:name": "{{ office_name | lower }}-{{ switch.vc_name }}"
    {% endif %}
    vc_position: {{ i + 1 }}
    vc_priority: {{ switch.vc_priorities[i] }}
    interfaces:
      - "!create_or_update:name": "{{ switch.mgmt_interface }}"
        ip_address_assignments:
          - ip_address: "!ref:ip_switch_{{ i }}"
    primary_ip4: { "!get:address": "!ref:ip_switch_{{ i }}", deferred: true }
{% endfor %}

# Dynamic PDUs
{% for i in range(pdu_count) %}
  - "!create_or_update:name": "{{ dev_name('pdu' ~ (i + 1)) }}"
    location: "!ref:office"
    device_type__model: "{{ pdu.model }}"
    role__name: "{{ pdu.role }}"
    platform__name: "{{ pdu.platform }}"
    status__name: "Planned"
    rack: "!ref:{{ pdu.rack }}"
    position: {{ get_device_position("pdu", i) }}
    face: front
    "!ref": "pdu{{ i + 1 }}"
    interfaces:
      - "!create_or_update:name": "{{ pdu.mgmt_interface }}"
        ip_address_assignments:
          - ip_address: "!ref:ip_pdu_{{ i }}"
    primary_ip4: { "!get:address": "!ref:ip_pdu_{{ i }}", deferred: true }
{% endfor %}

# Access points
{% for i in range(ap_count) %}
  - "!create_or_update:name": "{{ dev_name('ap' ~ i) }}"
    location: "!ref:office"
    device_type__model: "{{ access_point.model }}"
    role__name: "{{ access_point.role }}"
    status__name: "Planned"
    interfaces:
      - "!create_or_update:name": "{{ access_point.mgmt_interface }}"
        ip_address_assignments:
          - ip_address: "!ref:ip_ap_{{ i }}"
    primary_ip4: { "!get:address": "!ref:ip_ap_{{ i }}", deferred: true }
{% endfor %}
