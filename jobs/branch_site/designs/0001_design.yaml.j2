---
locations:
  - name: "{{ site_name }}"
    parent__name: "{{ region.name }}"
    location_type__name: "Site"
    status__name: "Planned"
    "!ref": "site"
    prefixes:
      - prefix: "{{ site_prefix }}"
        status__name: "Active"
        "!ref": "parent_prefix"

racks:
  - name: "{{ site_name }}-101"
    "!ref": "rack1"
    location: "!ref:site"
    status__name: "Planned"

  - name: "{{ site_name }}-201"
    "!ref": "rack2"
    location: "!ref:site"
    status__name: "Planned"

{% macro device(device_name, rack_ref, mgmt_address, model, role, platform, rack_pos) -%}
  - name: "{{ device_name }}.{{ site_name | lower }}"
    location: "!ref:site"
    device_type__model: {{ model }}
    role__name: {{ role }}
    status__name: "Planned"
    platform__name: {{ platform }}
    rack: "!ref:{{ rack_ref }}"
    position: {{ rack_pos }}
    face: front
{% endmacro %}

{% macro access_point(index, model) -%}
  - name: "ap{{ index }}.{{ site_name | lower }}"
    location: "!ref:site"
    device_type__model: {{ model }}
    role__name: "Wireless Access Point"
    status__name: "Planned"
{% endmacro %}

devices:
  {{ device("firewall01", "rack1", "10.0.0.1", "PA-3220", "Firewall", "PAN-OS", "30") }}
  {{ device("firewall02", "rack1", "10.0.0.2", "PA-3220", "Firewall", "PAN-OS", "29") }}
  {{ device("switch01", "rack1", "10.0.0.3", "C9300-48P-A", "Access Switch", "Cisco IOS", "28") }}
  {{ device("switch02", "rack1", "10.0.0.4", "C9300-48P-A", "Access Switch", "Cisco IOS", "27") }}
  {{ device("opengear01", "rack1", "10.0.0.5", "OM1208-8e", "Console Server", "Linux", "26") }}
  {{ device("pdu01", "rack1", "10.0.0.6", "AP9570", "PDU", "Linux", "25") }}
  {% for index in range(aps_per_site) %}
  {{ access_point(index, "MR36") }}
  {% endfor %}