---
{% set office_name = office.name %}
{% set office_prefix_cidr = office_prefix.prefix | string %}
{% set vlans = vlan_sets[office_type] %}

prefixes:
  - "!get:id": "{{ office_prefix.id }}"
    "!ref": "parent_prefix"

locations:
  - "!get:id": "{{ office.id }}"
    "!ref": "office"
    vlans:
    {% for v in vlans %}
      - "!create_or_update:vid": {{ v.vid }}
        "!create_or_update:name": "{{ office_name }}-{{ v.name }}"
        description: "{{ v.description }}"
        status__name: "Active"
        "!ref": "vlan_{{ v.vid }}"
    {% endfor %}
    prefixes:
    {% for v in vlans %}
      - "!create_or_update:prefix": "{{ get_child_prefix_cidr(office_prefix_cidr, v.offset) }}"
        status__name: "Active"
        locations: ["!ref:office"]
        vlan: "!ref:vlan_{{ v.vid }}"
        "!ref": "vlan_prefix_{{ v.vid }}"
    {% endfor %}

racks:
  - "!create_or_update:name": "{{ office_name }}-101"
    "!ref": "rack1"
    location: "!ref:office"
    status__name: "Planned"

{% set mgmt_vlan = vlans | selectattr('name', 'eq', management.vlan) | first %}
{% set mgmt_base = mgmt_vlan.offset.split('/')[0].rsplit('.', 1)[0] %}
{% set mgmt_mask = mgmt_vlan.prefix %}
{% macro mgmt_ip(host) %}{{ office_prefix_cidr | network_offset(mgmt_base ~ '.' ~ host ~ '/' ~ mgmt_mask) }}{% endmacro %}
{% macro device_name(role, index, office) %}{{ device_detail[role].name_prefix }}-{{ '%02d' | format(index) }}.{{ office | lower }}{% endmacro %}

{% set device_counts = get_device_counts() %}
devices:
{% for device, count in device_counts.items() %}
    {% for i in range(1, count + 1) %}
  - "!create_or_update:name": "{{ device_name(device, i, office_name) }}"
    location: "!ref:office"
    device_type__model: "{{ device_detail[device].model }}"
    role__name: "{{ device_detail[device].role }}"
    platform__name: "{{ device_detail[device].platform }}"
    status__name: "Planned"
    {% if device_detail[device].rack is defined %}
    rack: "{{ device_detail[device].rack }}"
    position: "{{ device_detail[device].position }}" 
    face: front
    {% endif %}
{% endfor %}
