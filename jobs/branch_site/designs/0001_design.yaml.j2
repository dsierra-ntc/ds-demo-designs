---
locations:
  - name: "{{ site_name }}"
    parent__name: "{{ region.name }}"
    location_type__name: "Site"
    status__name: "Planned"
    "!ref": "site"
    vlans:
    {% for v in vlans %}
      - "!create_or_update:vid": {{ v.vid }}
        "!create_or_update:name": "{{ site_name }}-{{ v.name }}"
        description: "{{ v.description }}"
        status__name: "Active"
        "!ref": "vlan_{{ v.vid }}"
    {% endfor %}
    prefixes:
      - prefix: "{{ site_prefix }}"
        status__name: "Active"
        "!ref": "parent_prefix"
    {% for v in vlans %}
      - "!child_prefix":
          parent: "!ref:parent_prefix"
          offset: "{{ v.offset }}"
        status__name: "Active"
        location: "!ref:site"
        vlan: "!ref:vlan_{{ v.vid }}"
    {% endfor %}

racks:
  - name: "{{ site_name }}-101"
    "!ref": "rack1"
    location: "!ref:site"
    status__name: "Planned"

  - name: "{{ site_name }}-201"
    "!ref": "rack2"
    location: "!ref:site"
    status__name: "Planned"

{% macro dev_name(base) %}{{ base }}.{{ site_name | lower }}{% endmacro %}

devices:
{% for d in devices %}
  - name: "{{ dev_name(d.name) }}"
    location: "!ref:site"
    device_type__model: "{{ d.model }}"
    role__name: "{{ d.role }}"
    platform__name: "{{ d.platform }}"
    status__name: "Planned"
    {% if d.rack is defined %}
    rack: "!ref:{{ d.rack }}"
    position: {{ d.position }}
    face: front
    {% endif %}
{% endfor %}
{% for i in range(aps_per_site) %}
  - name: "{{ dev_name('ap' ~ i) }}"
    location: "!ref:site"
    device_type__model: "{{ access_point.model }}"
    role__name: "{{ access_point.role }}"
    status__name: "Planned"
{% endfor %}

cables:
{% for c in cables %}
  - "!lookup:termination_a":
      content-type: "dcim.interface"
      device__name: "{{ dev_name(c.a.device) }}"
      name: "{{ c.a.port }}"
    "!lookup:termination_b":
      content-type: "dcim.interface"
      device__name: "{{ dev_name(c.b.device) }}"
      name: "{{ c.b.port }}"
    status__name: "Planned"
{% endfor %}
{% for i in range(aps_per_site) %}
  - "!lookup:termination_a":
      content-type: "dcim.interface"
      device__name: "{{ dev_name('ap' ~ i) }}"
      name: "eth1"
    "!lookup:termination_b":
      content-type: "dcim.interface"
      device__name: "{{ dev_name(access_point.switch) }}"
      name: "Eth1/{{ access_point.first_port + i }}"
    status__name: "Planned"
{% endfor %}
